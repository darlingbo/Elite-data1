{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "elite-data1.vercel.app" }],
      "destination": "https://elitedata1.com/$1",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/snapshot",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/snapshot",
      "schedule": "59 23 * * *"
    },
    {
      "path": "/api/cron/sync-orders",
      "schedule": "5 0 * * *"
    },
    {
      "path": "/api/cron/keepalive",
      "schedule": "0 8 */3 * *"
    }
  ]
}
